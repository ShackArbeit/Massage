# 複製為 .env.local 後填入（.env.local 不進版控）
# Firebase Web App 設定：`npx firebase apps:sdkconfig WEB` 取得
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=massage-37b8c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=massage-37b8c
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 後台管理員 Google 帳號
VITE_ADMIN_EMAIL=

# 隱私聲明中的資料刪除聯絡信箱（留空則使用 VITE_ADMIN_EMAIL）
VITE_CONTACT_EMAIL=

# App Check：Google Cloud Fraud Defense（reCAPTCHA Enterprise）網站金鑰
VITE_RECAPTCHA_SITE_KEY=

# 本地開發連接 Firebase 模擬器：true / false（正式建置以 .env.production.local 設為 false）
VITE_USE_EMULATORS=true
